# Point the admin dashboard at the EnzymeLM API.
# Local dev: leave NEXT_PUBLIC_API_URL unset — the browser uses same-origin `/api`,
# which next.config.ts proxies to BACKEND_ORIGIN below.
BACKEND_ORIGIN=http://127.0.0.1:5000

# Production: set the public API base (with /api suffix), e.g.
# NEXT_PUBLIC_API_URL=https://api.synbio.atriauniversity.ai/api
#
# Remember to add this admin origin (https://admin-synbio.atriauniversity.ai)
# to the backend's CORS_ORIGINS env when deploying.
